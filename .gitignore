# =============================================================================
# Repository-wide ignore rules. Folder-specific rules also live in
# dashboard/.gitignore, dashboard/database/.gitignore and plugin/tests/.gitignore.
# Tests (plugin/tests/run.php, dashboard/tests/) ARE committed on purpose; only
# their by-products are ignored below.
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets and credentials (never commit)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.crt
*.csr
*.secret
*.secrets
secrets.*
credentials.*
id_rsa*
id_ed25519*
auth.json
.npmrc.local
*.kdbx

# -----------------------------------------------------------------------------
# Databases, dumps and backup artifacts (contain site data and password hashes)
# -----------------------------------------------------------------------------
*.sqlite
*.sqlite-*
*.sqlite.*
*.sqlite3
*.db
*.sql
*.sql.gz
*.bak
*.backup
*.backup-*
spsync-backups/
spsync-backup-*/
spsync-backup-*.zip
spsync-import-*/
spsync-download-*/

# -----------------------------------------------------------------------------
# Test and tooling by-products (the tests themselves are committed)
# -----------------------------------------------------------------------------
.phpunit.result.cache
.phpunit.cache/
coverage/
coverage.xml
clover.xml
junit.xml
.pest/
.php-cs-fixer.cache
.php_cs.cache
.phpactor.json
plugin/tests/.runtime/

# -----------------------------------------------------------------------------
# Logs and runtime files
# -----------------------------------------------------------------------------
*.log
/logs/
npm-debug.log*
yarn-error.log*

# -----------------------------------------------------------------------------
# Dependencies and build output (rebuilt with composer install / npm run build)
# -----------------------------------------------------------------------------
/vendor/
/node_modules/
dashboard/vendor/
dashboard/node_modules/
dashboard/public/build/
dashboard/public/hot

# -----------------------------------------------------------------------------
# Laravel framework storage
# -----------------------------------------------------------------------------
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/framework/testing/*
storage/logs/*.log
!storage/framework/cache/.gitignore
!storage/framework/sessions/.gitignore
!storage/framework/views/.gitignore
!storage/framework/testing/.gitignore
!storage/logs/.gitignore

# -----------------------------------------------------------------------------
# AI assistant / Laravel Boost tooling (kept on each developer's machine)
# -----------------------------------------------------------------------------
.claude/
.agents/
.codex/
.cursor/
.mcp.json
boost.json
CLAUDE.md
CLAUDE.local.md
AGENTS.md

# -----------------------------------------------------------------------------
# Editors and operating systems
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
.zed/
*.sublime-workspace
*.sublime-project
*.swp
*~

# -----------------------------------------------------------------------------
# Out of scope for this repository
# -----------------------------------------------------------------------------
/backup_dashboard/
/backup_plugin_V2/
/seo_agentic_backend_package 1/
